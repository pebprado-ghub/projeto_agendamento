            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "code_validate_onboarding_secret": {
      "main": [
        [
          {
            "node": "if_secret_valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "if_secret_valid": {
      "main": [
        [
          {
            "node": "code_build_onboarding_plan",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "respond_onboarding_unauthorized",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "code_build_onboarding_plan": {
      "main": [
        [
          {
            "node": "respond_onboarding_success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
